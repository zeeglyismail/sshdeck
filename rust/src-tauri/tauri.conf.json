{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHDeck",
  "version": "1.5.2",
  "identifier": "cloud.onnorokom.sshdeck",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SSHDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#1c1c1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Ismail (zeeglyismail)",
    "copyright": "MIT licensed",
    "category": "DeveloperTool",
    "shortDescription": "Self-hosted SSH client: terminals, SFTP, tunnels, monitoring",
    "longDescription": "SSHDeck desktop — SSH terminals with split panes and MultiExec, dual-pane SFTP with server-to-server transfers, port forwarding (local/remote/SOCKS), agentless host monitoring, saved identities and keys.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
